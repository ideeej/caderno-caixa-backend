generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  @@map("users")

  id String @id
  name String
  email String @unique
  password String
  createdAt DateTime
  cashRegister CashRegister[]
  sales Sale[]
}

model CashRegister {
  @@map("CashRegisters")

  id String @id

  userId String
  user User @relation(fields: [userId], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime? 
  initialAmount Int
  closingAmount Int?
  isOpen Boolean
  sales Sale[]

}

model Sale {
  @@map("Sales")

  id String @id @default(uuid())

  userId         String
  user           User           @relation(fields: [userId], references: [id])
  cashRegisterId String
  cashRegister   CashRegister   @relation(fields: [cashRegisterId], references: [id])

  openedAt    DateTime
  closedAt    DateTime?
  cancelledAt DateTime?
  finishedAt  DateTime?

  items    Json[]    // Representa o SaleItem[] do seu domínio
  state    String
  customer Json?     // Representa o ICustomer
  payments Json[]    // Representa o Payment[]
}
