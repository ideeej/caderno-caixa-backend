generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  @@map("users")

  id String @id
  name String
  email String @unique
  password String
  createdAt DateTime
  cashRegister CashRegister[]
}

model CashRegister {
  @@map("CashRegisters")

  id String @id

  userId String
  user User @relation(fields: [userId], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime? 
  initialAmount Int
  closingAmount Int?
  isOpen Boolean

}
